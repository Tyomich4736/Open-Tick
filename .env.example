# Environment variables (copy to .env) — optional fallback

# Prefer Settings → Account in the app for Client ID / Secret.
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_REDIRECT_URI=http://127.0.0.1:18463/callback
TICKTICK_API_BASE=https://api.ticktick.com/open/v1
TICKTICK_AUTH_BASE=https://ticktick.com
TICKTICK_SCOPES=tasks:read tasks:write
# TICKTICK_REGION=ticktick

# Dev only — personal access token (optional shortcut; skips browser OAuth)
# TICKTICK_ACCESS_TOKEN=
